class Solution {
    int maxNtype(int arr[]) {
        int n = arr.length;
        int ascBreak = 0;
        int descBreak = 0;

        for(int i = 0; i < n - 1; i++){
            if(arr[i] > arr[i + 1])
                ascBreak++;
            else
                descBreak++;
        }

        // Ascending
        if(ascBreak == 0)
            return 1;

        // Descending
        if(descBreak == 0)
            return 2;

        // Ascending Rotated
        if(ascBreak == 1 && arr[n-1] <= arr[0])
            return 4;

        // Descending Rotated
        return 3;      
            }
        }
